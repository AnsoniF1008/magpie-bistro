# ── Required in production ─────────────────────────────────────────────
# Long random string. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Public URL of the site, no trailing slash. Used in emails, payment return links, sitemap and SEO tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────
# Empty        → SQLite file at ./data/magpie.db (local development, zero setup)
# postgres://… → Postgres (Neon). Use the pooled connection string.
DATABASE_URL=
# Google Cloud SQL instead of a connection string (this is what the Firebase deployment uses):
# CLOUD_SQL_INSTANCE=project:region:instance
# DB_USER=magpie
# DB_NAME=magpie
# DB_PASSWORD=

# ── Photo storage ──────────────────────────────────────────────────────
# Empty → ./media on disk. A server's disk does not persist, so in production use a bucket:
# Firebase / Google Cloud → name of a Cloud Storage bucket
GCS_BUCKET=
# Vercel → Blob store token
BLOB_READ_WRITE_TOKEN=

# ── Stripe (empty → demo payment pages, no real charges) ──────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email via Resend (empty → emails are written to ./data/outbox) ─────
RESEND_API_KEY=
# From address on a domain verified in Resend, e.g. "The Magpie Bistro <orders@yourdomain.com>"
EMAIL_FROM=
# Where new-order notifications go when not set in Site settings
BISTRO_NOTIFICATION_EMAIL=themagpiecupcakery@gmail.com

# ── Rate limiting via Upstash (empty → in-memory limiter) ─────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics & search (all optional) ──────────────────────────────────
# GA4 measurement id (G-XXXXXXX). When set, a cookie banner asks before anything loads.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification code
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Error monitoring via Sentry (optional) ─────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Seed (optional) ────────────────────────────────────────────────────
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=
